{
  "version": 1,
  "about": "قوالب الأركان لمسار المستوى D: ما يحتاج المفتي أن يعرفه من الوقائع، دون أي حكم. لا سؤال عن اسم أو رقم هوية أو حساب بنكي أو تفاصيل جنسية. العرض المقروء: content/pillars-review.md",
  "limits": { "maxQuestions": 8, "generatedMin": 3, "generatedMax": 6 },
  "generationRules": {
    "ar": [
      "من 3 إلى 6 أسئلة عن الوقائع فقط: ماذا حدث، ومتى، وكم، وبأي صيغة، وفي أي ظرف.",
      "لا سؤال عن حكم أو رأي («هل يجوز…»، «هل هو حرام…»)، ولا تلميح إلى جواب.",
      "لا سؤال عن اسم، أو رقم هوية أو جواز، أو حساب بنكي، أو هاتف، أو بريد، أو عنوان، ولا عن تفاصيل جنسية.",
      "سؤال قصير واحد في كل مرة، بخيارات جاهزة حين يمكن.",
      "لا يُسأل عما ذكره السائل.",
      "تُعلَّم الأسئلة «مولّدة» ويقرؤها المفتي بهذه الصفة."
    ],
    "en": [
      "3 to 6 questions about facts only: what happened, when, how much, in what words, under what circumstances.",
      "No question about a ruling or an opinion (\"is it allowed…\", \"is it haram…\"), and no hint of an answer.",
      "Never ask for a name, ID or passport number, bank account, phone, email or address, nor for sexual details.",
      "One short question at a time, with ready options when possible.",
      "Do not ask about anything the asker already stated.",
      "Generated questions are marked \"generated\" and the mufti reads them as such."
    ]
  },
