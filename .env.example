# مُستفتي — متغيرات البيئة (الخطة، القسم 4ب). الشرح الكامل ومصدر كل قيمة: docs/SETUP.md
# انسخ هذا الملف إلى .env.local للتطوير، وضع القيم الحقيقية في Vercel فقط. لا أسرار في المستودع.
# القيم أدناه وهمية (your-…)؛ استبدلها بقيمك. ما عليه «إلزامي» لا تعمل المنصة دونه.

# --- Supabase ← Project Settings ← API (إلزامي) ---
# رابط المشروع (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# المفتاح العام (anon public / Publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# المفتاح السري (service_role / Secret key). سري جداً: للخادم فقط
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- النموذج اللغوي: OpenRouter (https://openrouter.ai/keys) ---
# مفتاح OpenRouter (إلزامي للمحادثة). يُفضَّل مفتاح بحد إنفاق
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# النموذج الأساسي (إلزامي، لا افتراضي في الكود). أي معرّف نموذج على OpenRouter يعمل
LLM_MODEL=openai/gpt-6-luna
# نموذج احتياطي عند تعطل المزوّد أو انتهاء المهلة (اختياري)
LLM_FALLBACK_MODEL=google/gemma-4-31b-it
# جهد التفكير (معامل reasoning في OpenRouter): minimal | low | medium | high | off.
# LLM_REASONING=off يطفئه كله؛ والبقية لكل مهمة، والافتراضي low.
LLM_REASONING=
LLM_REASONING_CLASSIFY=low
LLM_REASONING_RERANK=low
LLM_REASONING_ANSWER=low
# طبقة «ابحث واقرأ» (أدوات OpenRouter web_search وweb_fetch في نطاقات المرجعية). false يطفئها
FEATURE_WEB_TOOLS=true
# الحد اليومي لطلبات النموذج (يوم UTC، عدّاد مشترك في Supabase)
DAILY_LLM_LIMIT=1500

# --- المصادر ---
# خادم MCP الرسمي للجمعية (بلا مفتاح). هذا الافتراضي في الكود إن تُرك فارغاً
MCP_URL=https://mcp.islamiccontent.org/mcp
# F1b: مكتبة IslamHouse عبر واجهتها البرمجية الرسمية. هذا المفتاح العام الموثّق في developers.islamhouse.com
# (ليس سراً)، وهو الافتراضي في الكود إن تُرك المتغير فارغاً.
ISLAMHOUSE_API_KEY=paV29H2gm56kvLPy

# --- الإدارة ---
# بريد المشرف الأعلى (أو أكثر، مفصولة بفواصل): يُعطى super_admin عند أول دخول
ADMIN_EMAILS=admin@mustafti.com
# مشرفون تجريبيون يدخلون اللوحة بلا MFA مع شريط «حساب تجريبي» (مفصولة بفواصل).
# لا أثر لها إلا لحساب له دور في جدول admins
DEMO_NO_MFA_EMAILS=admin@mustafti.com
# كلمة سرية لمسار لوحة المشرف: /ar/<ADMIN_PATH> (أحرف إنجليزية صغيرة وأرقام وشرطة)
ADMIN_PATH=your-secret-admin-path

# --- F5: دخول تجريبي للجنة التحكيم (للعرض فقط، ويُحذف بعد المسابقة) ---
# الأزرار والمسار POST /api/demo-login لا يعملان إلا مع DEMO_LOGIN=true وكلمة المرور
# المشتركة للحسابات الثلاثة (user@ / specialized@ / admin@mustafti.com)
DEMO_LOGIN=true
DEMO_ACCOUNTS_PASSWORD=your-demo-accounts-password
