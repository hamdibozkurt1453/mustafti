# مُستفتي — متغيرات البيئة (الخطة، القسم 4ب).
# انسخ هذا الملف إلى .env.local للتطوير، وضع القيم الحقيقية في Vercel فقط. لا أسرار في المستودع.

# Supabase ← Settings ← API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# سري جداً: للخادم فقط
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (مفتاح mustafti بحد إنفاق)
OPENROUTER_API_KEY=
# المعتمد بعد اختبار النماذج (S3): google/gemma-4-31b-it
LLM_MODEL=
# نموذج احتياطي عند تعطل المزوّد أو انتهاء المهلة (اختياري)، مثل: google/gemini-2.5-flash
LLM_FALLBACK_MODEL=
# جهد التفكير لنماذج التفكير (معامل reasoning في OpenRouter): minimal | low | medium | high | off.
# الافتراضي: low للتصنيف والتقييم، وmedium للصياغة. LLM_REASONING=off يطفئه كله.
LLM_REASONING=
LLM_REASONING_CLASSIFY=low
LLM_REASONING_RERANK=low
LLM_REASONING_ANSWER=medium
# طبقة «ابحث واقرأ» (أدوات OpenRouter web_search وweb_fetch في نطاقات المرجعية). false يطفئها.
FEATURE_WEB_TOOLS=true

# خادم MCP الرسمي للجمعية (بلا مفتاح)
MCP_URL=https://mcp.islamiccontent.org/mcp

# بريد المشرف الأعلى (أو أكثر، مفصولة بفواصل)
ADMIN_EMAILS=
# حسابات تجريبية (للجنة التحكيم مثلاً): مشرف بريده هنا يدخل اللوحة بلا MFA مع شريط «حساب تجريبي».
# مفصولة بفواصل. لا أثر لها إلا لحساب له دور في جدول admins، ولا تُطبَّق على غيره أبداً.
DEMO_NO_MFA_EMAILS=
# كلمة سرية لمسار لوحة المشرف: /ar/<ADMIN_PATH>
ADMIN_PATH=

# الحد اليومي لطلبات النموذج (يوم UTC، عدّاد مشترك في Supabase)
DAILY_LLM_LIMIT=1500
